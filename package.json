{
  "name": "ai-blocker-stickers",
  "description": "Opaque, content-anchored stickers that hide sensitive page regions from AI agents (screenshots and page readers).",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Vinh Nguyen (vincent3DArt)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincent3DArt/ai-blocker-stickers.git"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:dev": "wxt build --mode development",
    "e2e": "wxt build --mode development && playwright test",
    "scan": "node scripts/scan-fixtures.mjs",
    "fixtures": "vite preview --outDir fixtures --port 4173 --strictPort",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^26.6.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.2",
    "wxt": "^0.21.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
